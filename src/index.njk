<!DOCTYPE html>
<html lang="en">

<head>

  <meta charset="UTF-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1.0"
  >

  <title>
    {{ site.brand_name or "DubaiLink Realty" }}
    | {{ site.brand_tagline or "Luxury Real Estate" }}
  </title>

  <meta
    name="description"
    content="{{ site.meta_description or 'DubaiLink Realty — luxury real estate opportunities in Dubai.' }}"
  >

  <link rel="preconnect" href="https://fonts.googleapis.com">

  <link
    rel="preconnect"
    href="https://fonts.gstatic.com"
    crossorigin
  >

  <link
    href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@400;500;600;700&family=Inter:wght@300;400;500;600&display=swap"
    rel="stylesheet"
  >

  <style>

    :root {

      --brown-950: #160f0b;
      --brown-900: #21150f;
      --brown-800: #2d1d15;
      --brown-700: #3d291e;

      --gold: #c5a46d;
      --gold-light: #dfc58f;

      --cream: #f5f0e7;
      --white: #ffffff;

      --muted: #b9aea2;

      --border:
        rgba(197, 164, 109, 0.25);

      --heading-font:
        "Cormorant Garamond",
        Georgia,
        serif;

      --body-font:
        "Inter",
        Arial,
        sans-serif;

      --container: 1180px;

      --transition:
        0.3s ease;
    }


    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }


    html {
      scroll-behavior: smooth;
    }


    body {

      background:
        var(--brown-950);

      color:
        var(--cream);

      font-family:
        var(--body-font);

      line-height:
        1.7;
    }


    img {

      width: 100%;

      display: block;

      object-fit: cover;
    }


    a {

      color: inherit;

      text-decoration: none;
    }


    button,
    input,
    textarea {

      font: inherit;
    }


    .container {

      width:
        min(92%, var(--container));

      margin-inline:
        auto;
    }


    .section {

      padding:
        110px 0;
    }


    .eyebrow {

      color:
        var(--gold);

      font-size:
        12px;

      letter-spacing:
        3px;

      text-transform:
        uppercase;

      margin-bottom:
        16px;
    }


    .section-title {

      font-family:
        var(--heading-font);

      font-size:
        clamp(42px, 5vw, 68px);

      font-weight:
        500;

      line-height:
        1;

      margin-bottom:
        25px;
    }


    .section-text {

      color:
        var(--muted);

      max-width:
        680px;
    }


    /* =====================================
       HEADER
    ====================================== */

    .site-header {

      position:
        fixed;

      inset:
        0 0 auto;

      z-index:
        1000;

      background:
        rgba(22, 15, 11, 0.94);

      border-bottom:
        1px solid var(--border);

      backdrop-filter:
        blur(12px);
    }


    .nav {

      min-height:
        82px;

      display:
        flex;

      align-items:
        center;

      justify-content:
        space-between;

      gap:
        30px;
    }


    .brand {

      display:
        flex;

      align-items:
        center;

      gap:
        14px;
    }


    .brand-logo {

      width:
        48px;

      height:
        48px;

      object-fit:
        contain;
    }


    .brand-text strong {

      display:
        block;

      font-family:
        var(--heading-font);

      font-size:
        24px;

      font-weight:
        600;

      line-height:
        1;
    }


    .brand-text small {

      color:
        var(--gold);

      font-size:
        8px;

      letter-spacing:
        2px;

      text-transform:
        uppercase;
    }


    .nav-links {

      display:
        flex;

      align-items:
        center;

      gap:
        28px;

      list-style:
        none;
    }


    .nav-links a {

      font-size:
        12px;

      letter-spacing:
        1px;

      text-transform:
        uppercase;

      transition:
        var(--transition);
    }


    .nav-links a:hover {

      color:
        var(--gold-light);
    }


    .nav-cta {

      padding:
        12px 20px;

      border:
        1px solid var(--gold);

      color:
        var(--gold-light) !important;
    }


    .menu-toggle {

      display:
        none;

      border:
        1px solid var(--border);

      background:
        transparent;

      color:
        var(--cream);

      padding:
        8px 12px;

      cursor:
        pointer;
    }


    /* =====================================
       PARTNER
    ====================================== */

    .partner-bar {

      padding:
        100px 0 18px;

      background:
        var(--brown-900);

      border-bottom:
        1px solid var(--border);
    }


    .partner-inner {

      display:
        flex;

      justify-content:
        flex-end;

      align-items:
        center;

      gap:
        15px;

      color:
        var(--muted);

      font-size:
        11px;

      letter-spacing:
        1.5px;

      text-transform:
        uppercase;
    }


    .partner-logo {

      width:
        110px;

      height:
        38px;

      object-fit:
        contain;
    }


    /* =====================================
       HERO
    ====================================== */

    .hero {

      min-height:
        760px;

      display:
        grid;

      align-items:
        center;

      background:

        linear-gradient(
          90deg,
          rgba(22,15,11,.96),
          rgba(22,15,11,.60),
          rgba(22,15,11,.78)
        ),

        url("{{ site.hero_image or '/assets/images/hero.jpg' }}")
        center/cover;
    }


    .hero-content {

      max-width:
        780px;

      padding:
        100px 0;
    }


    .hero h1 {

      font-family:
        var(--heading-font);

      font-size:
        clamp(58px, 8vw, 105px);

      font-weight:
        500;

      line-height:
        .9;

      margin-bottom:
        30px;
    }


    .hero h1 span {

      color:
        var(--gold-light);

      font-style:
        italic;

      display:
        block;
    }


    .hero p {

      color:
        #ddd1c4;

      max-width:
        600px;

      font-size:
        17px;

      margin-bottom:
        35px;
    }


    .button {

      display:
        inline-flex;

      align-items:
        center;

      justify-content:
        center;

      min-height:
        50px;

      padding:
        0 25px;

      border:
        1px solid var(--gold);

      background:
        var(--gold);

      color:
        var(--brown-950);

      text-transform:
        uppercase;

      font-size:
        11px;

      letter-spacing:
        1.5px;

      transition:
        var(--transition);
    }


    .button:hover {

      background:
        transparent;

      color:
        var(--gold-light);
    }


    .button-outline {

      background:
        transparent;

      color:
        var(--gold-light);

      margin-left:
        10px;
    }


    /* =====================================
       ABOUT
    ====================================== */

    .about {

      background:
        var(--cream);

      color:
        var(--brown-900);
    }


    .about .section-text {

      color:
        #62564c;
    }


    .about-grid {

      display:
        grid;

      grid-template-columns:
        1.1fr .9fr;

      gap:
        70px;

      align-items:
        center;
    }


    .about-image {

      min-height:
        520px;
    }


    .about-image img {

      height:
        100%;
    }


    /* =====================================
       VISION / MISSION
    ====================================== */

    .dark-section {

      background:
        var(--brown-900);
    }


    .two-column {

      display:
        grid;

      grid-template-columns:
        1fr 1fr;

      gap:
        1px;

      background:
        var(--border);

      margin-top:
        55px;
    }


    .info-card {

      background:
        var(--brown-900);

      padding:
        55px;
    }


    .info-card h3 {

      color:
        var(--gold-light);

      font-family:
        var(--heading-font);

      font-size:
        42px;

      font-weight:
        500;

      margin-bottom:
        15px;
    }


    .info-card p {

      color:
        var(--muted);
    }


    /* =====================================
       CHAIRMAN
    ====================================== */

    .chairman-grid {

      display:
        grid;

      grid-template-columns:
        .8fr 1.2fr;

      gap:
        70px;

      align-items:
        center;
    }


    .chairman-image img {

      aspect-ratio:
        4 / 5;
    }


    .quote {

      color:
        var(--cream);

      font-family:
        var(--heading-font);

      font-size:
        clamp(30px, 4vw, 50px);

      line-height:
        1.15;

      margin:
        25px 0;
    }


    .chairman-name {

      color:
        var(--gold-light);

      font-size:
        13px;

      letter-spacing:
        2px;

      text-transform:
        uppercase;
    }


    /* =====================================
       APPROACH
    ====================================== */

    .approach {

      background:
        var(--cream);

      color:
        var(--brown-900);
    }


    .approach .section-text {

      color:
        #62564c;
    }


    .approach-grid {

      display:
        grid;

      grid-template-columns:
        repeat(4, 1fr);

      margin-top:
        60px;

      border-top:
        1px solid rgba(61,41,30,.2);

      border-left:
        1px solid rgba(61,41,30,.2);
    }


    .approach-card {

      padding:
        38px 28px;

      min-height:
        250px;

      border-right:
        1px solid rgba(61,41,30,.2);

      border-bottom:
        1px solid rgba(61,41,30,.2);
    }


    .approach-number {

      color:
        var(--gold);

      font-family:
        var(--heading-font);

      font-size:
        35px;
    }


    .approach-card h3 {

      font-family:
        var(--heading-font);

      font-size:
        28px;

      margin:
        15px 0;
    }


    .approach-card p {

      color:
        #62564c;

      font-size:
        14px;
    }


    /* =====================================
       PROJECTS
    ====================================== */

    .projects {

      background:
        var(--brown-950);
    }


    .projects-grid {

      display:
        grid;

      grid-template-columns:
        repeat(2, 1fr);

      gap:
        30px;

      margin-top:
        60px;
    }


    .project-card {

      border:
        1px solid var(--border);

      background:
        var(--brown-900);

      overflow:
        hidden;
    }


    .project-image {

      height:
        360px;

      position:
        relative;
    }


    .project-image img {

      height:
        100%;
    }


    .project-status {

      position:
        absolute;

      top:
        20px;

      left:
        20px;

      padding:
        8px 13px;

      background:
        var(--gold);

      color:
        var(--brown-950);

      font-size:
        9px;

      letter-spacing:
        1.5px;

      text-transform:
        uppercase;
    }


    .project-content {

      padding:
        30px;
    }


    .project-content h3 {

      font-family:
        var(--heading-font);

      font-size:
        42px;

      font-weight:
        500;
    }


    .project-location {

      color:
        var(--gold);

      font-size:
        11px;

      letter-spacing:
        1.5px;

      text-transform:
        uppercase;

      margin:
        5px 0 20px;
    }


    .project-description {

      color:
        var(--muted);

      font-size:
        14px;

      margin-bottom:
        20px;
    }


    .project-meta {

      display:
        grid;

      grid-template-columns:
        repeat(3, 1fr);

      gap:
        10px;

      border-top:
        1px solid var(--border);

      border-bottom:
        1px solid var(--border);

      padding:
        18px 0;

      margin-bottom:
        22px;
    }


    .project-meta span {

      display:
        block;

      color:
        var(--muted);

      font-size:
        10px;

      text-transform:
        uppercase;
    }


    .project-meta strong {

      color:
        var(--cream);

      font-size:
        13px;

      font-weight:
        500;
    }


    .project-actions {

      display:
        flex;

      gap:
        10px;

      flex-wrap:
        wrap;
    }


    /* =====================================
       CONTACT
    ====================================== */

    .contact {

      background:
        var(--brown-800);
    }


    .contact-grid {

      display:
        grid;

      grid-template-columns:
        1fr 1fr;

      gap:
        70px;
    }


    .contact-list {

      list-style:
        none;

      margin-top:
        35px;
    }


    .contact-list li {

      padding:
        17px 0;

      border-bottom:
        1px solid var(--border);

      color:
        var(--muted);
    }


    .contact-list strong {

      display:
        block;

      color:
        var(--gold-light);

      font-size:
        11px;

      letter-spacing:
        1.5px;

      text-transform:
        uppercase;
    }


    .contact-form {

      display:
        grid;

      gap:
        15px;
    }


    .contact-form input,
    .contact-form textarea {

      width:
        100%;

      padding:
        16px;

      border:
        1px solid var(--border);

      background:
        var(--brown-950);

      color:
        var(--cream);

      outline:
        none;
    }


    .contact-form textarea {

      min-height:
        150px;

      resize:
        vertical;
    }


    /* =====================================
       FOOTER
    ====================================== */

    footer {

      background:
        #100b08;

      padding:
        65px 0 25px;

      border-top:
        1px solid var(--border);
    }


    .footer-grid {

      display:
        grid;

      grid-template-columns:
        1.3fr 1fr 1fr;

      gap:
        50px;

      padding-bottom:
        50px;
    }


    footer h3 {

      font-family:
        var(--heading-font);

      font-size:
        28px;

      margin-bottom:
        15px;
    }


    footer p,
    footer a {

      color:
        var(--muted);

      font-size:
        13px;
    }


    .footer-links {

      list-style:
        none;

      display:
        grid;

      gap:
        8px;
    }


    .newsletter {

      display:
        flex;

      margin-top:
        18px;
    }


    .newsletter input {

      min-width:
        0;

      flex:
        1;

      border:
        1px solid var(--border);

      background:
        var(--brown-900);

      color:
        var(--cream);

      padding:
        13px;
    }


    .newsletter button {

      border:
        1px solid var(--gold);

      background:
        var(--gold);

      padding:
        0 18px;

      cursor:
        pointer;
    }


    .footer-bottom {

      border-top:
        1px solid var(--border);

      padding-top:
        22px;

      display:
        flex;

      justify-content:
        space-between;

      gap:
        20px;

      color:
        #82776d;

      font-size:
        11px;
    }


    /* =====================================
       MOBILE
    ====================================== */

    @media (max-width: 900px) {

      .nav-links {

        position:
          absolute;

        top:
          82px;

        left:
          0;

        right:
          0;

        display:
          none;

        flex-direction:
          column;

        align-items:
          flex-start;

        padding:
          25px;

        background:
          var(--brown-900);

        border-bottom:
          1px solid var(--border);
      }


      .nav-links.active {

        display:
          flex;
      }


      .menu-toggle {

        display:
          block;
      }


      .about-grid,
      .chairman-grid,
      .contact-grid {

        grid-template-columns:
          1fr;
      }


      .two-column,
      .projects-grid {

        grid-template-columns:
          1fr;
      }


      .approach-grid {

        grid-template-columns:
          repeat(2, 1fr);
      }


      .footer-grid {

        grid-template-columns:
          1fr 1fr;
      }

    }


    @media (max-width: 600px) {

      .section {

        padding:
          75px 0;
      }


      .hero {

        min-height:
          680px;
      }


      .hero h1 {

        font-size:
          58px;
      }


      .button-outline {

        margin:
          10px 0 0;
      }


      .approach-grid,
      .footer-grid {

        grid-template-columns:
          1fr;
      }


      .info-card {

        padding:
          35px 25px;
      }


      .project-image {

        height:
          270px;
      }


      .project-meta {

        grid-template-columns:
          1fr;
      }


      .footer-bottom {

        flex-direction:
          column;
      }

    }

  </style>

</head>


<body>


  <!-- =====================================
       HEADER
  ====================================== -->

  <header class="site-header">

    <div class="container nav">

      <a
        href="#home"
        class="brand"
      >

        <img
          src="{{ site.logo or '/assets/images/dubailink-logo.svg' }}"
          alt="{{ site.brand_name or 'DubaiLink Realty' }}"
          class="brand-logo"
        >

        <span class="brand-text">

          <strong>
            {{ site.brand_name or "DubaiLink Realty" }}
          </strong>

          <small>
            {{ site.brand_tagline or "Luxury Real Estate" }}
          </small>

        </span>

      </a>


      <button
        class="menu-toggle"
        id="menuToggle"
        type="button"
      >
        Menu
      </button>


      <ul
        class="nav-links"
        id="navLinks"
      >

        <li>
          <a href="#home">
            Home
          </a>
        </li>

        <li>
          <a href="#about">
            About Us
          </a>
        </li>

        <li>
          <a href="#approach">
            Our Approach
          </a>
        </li>

        <li>
          <a href="#projects">
            Projects
          </a>
        </li>

        <li>
          <a href="#contact">
            Contact Us
          </a>
        </li>

        <li>
          <a
            href="#contact"
            class="nav-cta"
          >
            Pay Now
          </a>
        </li>

      </ul>

    </div>

  </header>



  <!-- =====================================
       PARTNER BAR
  ====================================== -->

  <div class="partner-bar">

    <div class="container partner-inner">

      <span>
        {{ site.partner_status or "Authorized Partner" }}
      </span>

      <img
        src="{{ site.partner_logo or '/assets/images/zoya-logo.svg' }}"
        alt="{{ site.partner_name or 'Zoya Developments' }}"
        class="partner-logo"
      >

    </div>

  </div>



  <main>


    <!-- =====================================
         HERO
    ====================================== -->

    <section
      class="hero"
      id="home"
    >

      <div class="container">

        <div class="hero-content">

          <div class="eyebrow">
            {{ site.hero_eyebrow or "Dubai Luxury Real Estate" }}
          </div>


          <h1>

            {{ site.hero_title or "Spaces Made For" }}

            <span>
              {{ site.hero_highlight or "Exceptional Living." }}
            </span>

          </h1>


          <p>
            {{ site.hero_description or
            "Discover thoughtfully selected residences and investment opportunities across Dubai, presented by DubaiLink Realty."
            }}
          </p>


          <a
            href="#projects"
            class="button"
          >
            Explore Projects
          </a>


          <a
            href="#contact"
            class="button button-outline"
          >
            Speak With Us
          </a>

        </div>

      </div>

    </section>



    <!-- =====================================
         ABOUT
    ====================================== -->

    <section
      class="section about"
      id="about"
    >

      <div class="container about-grid">


        <div class="about-image">

          <img
            src="{{ about.image or '/assets/images/about.jpg' }}"
            alt="DubaiLink Realty"
          >

        </div>


        <div>

          <div class="eyebrow">
            {{ about.eyebrow or "About DubaiLink Realty" }}
          </div>


          <h2 class="section-title">

            {{ about.title or
            "Connecting You With Dubai's Finest Addresses."
            }}

          </h2>


          <p class="section-text">

            {{ about.description or
            "DubaiLink Realty is a premium real estate brand focused on connecting clients with carefully selected residential and investment opportunities in Dubai."
            }}

          </p>


          {% if about.additional_description %}

            <br>

            <p class="section-text">
              {{ about.additional_description }}
            </p>

          {% endif %}

        </div>

      </div>

    </section>



    <!-- =====================================
         STORY / VISION / MISSION
    ====================================== -->

    <section class="section dark-section">

      <div class="container">

        <div class="eyebrow">
          Our Story
        </div>


        <h2 class="section-title">
          Built Around Trust.
        </h2>


        <p class="section-text">

          {{ about.story or
          "We believe property is more than an address. It is a decision that shapes lifestyles, businesses and long-term financial goals."
          }}

        </p>


        <div class="two-column">


          <article class="info-card">

            <div class="eyebrow">
              01
            </div>

            <h3>
              Our Vision
            </h3>

            <p>

              {{ visionMission.vision or
              "To become a trusted real estate destination for clients seeking exceptional properties and investment opportunities in Dubai."
              }}

            </p>

          </article>


          <article class="info-card">

            <div class="eyebrow">
              02
            </div>

            <h3>
              Our Mission
            </h3>

            <p>

              {{ visionMission.mission or
              "To deliver thoughtful property guidance through transparency, professional service and carefully selected opportunities."
              }}

            </p>

          </article>


        </div>

      </div>

    </section>



    <!-- =====================================
         CHAIRMAN
    ====================================== -->

    <section class="section dark-section">

      <div class="container chairman-grid">


        <div class="chairman-image">

          <img
            src="{{ chairman.photo or '/assets/images/chairman.jpg' }}"
            alt="{{ chairman.name or 'Chairman' }}"
          >

        </div>


        <div>

          <div class="eyebrow">
            Message From The Chairman
          </div>


          <h2 class="section-title">
            A Commitment To Lasting Value.
          </h2>


          <p class="quote">

            “{{ chairman.message or
            "Our goal is simple — to create trusted relationships and connect people with opportunities that truly matter."
            }}”

          </p>


          <div class="chairman-name">

            {{ chairman.name or "Farooq Khan" }}

            ·

            {{ chairman.designation or "Chairman" }}

          </div>

        </div>

      </div>

    </section>



    <!-- =====================================
         OUR APPROACH
    ====================================== -->

    <section
      class="section approach"
      id="approach"
    >

      <div class="container">

        <div class="eyebrow">
          Our Approach
        </div>


        <h2 class="section-title">
          Designed Around Better Living.
        </h2>


        <p class="section-text">

          {{ approach_intro or
          "We look beyond the property itself and consider design, technology, sustainability and long-term investment value."
          }}

        </p>


        <div class="approach-grid">


          {% for item in collections.approach %}

            <article class="approach-card">

              <div class="approach-number">

                {{ item.data.number or loop.index }}

              </div>


              <h3>

                {{ item.data.title }}

              </h3>


              <p>

                {{ item.data.description }}

              </p>

            </article>

          {% else %}


            <article class="approach-card">

              <div class="approach-number">
                01
              </div>

              <h3>
                Elevated Design
              </h3>

              <p>
                Carefully considered architecture and interiors
                created for contemporary lifestyles.
              </p>

            </article>


            <article class="approach-card">

              <div class="approach-number">
                02
              </div>

              <h3>
                Smart Homes
              </h3>

              <p>
                Modern technology and connected living for
                greater convenience and comfort.
              </p>

            </article>


            <article class="approach-card">

              <div class="approach-number">
                03
              </div>

              <h3>
                Sustainable Development
              </h3>

              <p>
                A forward-looking perspective that values
                responsible development.
              </p>

            </article>


            <article class="approach-card">

              <div class="approach-number">
                04
              </div>

              <h3>
                Investment Value
              </h3>

              <p>
                Opportunities selected with lifestyle appeal
                and long-term investment potential in mind.
              </p>

            </article>

          {% endfor %}


        </div>

      </div>

    </section>



    <!-- =====================================
         DYNAMIC PROJECTS
    ====================================== -->

    <section
      class="section projects"
      id="projects"
    >

      <div class="container">


        <div class="eyebrow">
          Featured Developments
        </div>


        <h2 class="section-title">
          Selected Projects.
        </h2>


        <p class="section-text">

          Explore selected developments represented
          through DubaiLink Realty.

        </p>


        <div class="projects-grid">


          {% for project in collections.projects %}


            <article class="project-card">


              <div class="project-image">


                <img
                  src="{{ project.data.image or '/assets/images/project-placeholder.jpg' }}"
                  alt="{{ project.data.title or 'Property Project' }}"
                  loading="lazy"
                >


                {% if project.data.status %}

                  <span class="project-status">
                    {{ project.data.status }}
                  </span>

                {% endif %}


              </div>



              <div class="project-content">


                <h3>

                  {{ project.data.title or "Untitled Project" }}

                </h3>


                {% if project.data.location %}

                  <div class="project-location">

                    {{ project.data.location }}

                  </div>

                {% endif %}



                {% if project.data.description %}

                  <p class="project-description">

                    {{ project.data.description }}

                  </p>

                {% endif %}



                <div class="project-meta">


                  <div>

                    <span>
                      Starting From
                    </span>

                    <strong>

                      {{ project.data.price or "Contact Us" }}

                    </strong>

                  </div>


                  <div>

                    <span>
                      Payment Plan
                    </span>

                    <strong>

                      {{ project.data.payment_plan or "Available" }}

                    </strong>

                  </div>


                  <div>

                    <span>
                      Handover
                    </span>

                    <strong>

                      {{ project.data.handover or "TBA" }}

                    </strong>

                  </div>


                </div>



                <div class="project-actions">


                  {% if project.data.brochures %}


                    {% for brochure in project.data.brochures %}


                      {% if brochure.file %}

                        <a
                          href="{{ brochure.file }}"
                          class="button"
                          target="_blank"
                          rel="noopener"
                        >
                          {{ brochure.name or "Brochure" }}
                        </a>


                      {% elif brochure.url %}

                        <a
                          href="{{ brochure.url }}"
                          class="button"
                          target="_blank"
                          rel="noopener"
                        >
                          {{ brochure.name or "Brochure" }}
                        </a>

                      {% endif %}


                    {% endfor %}


                  {% endif %}



                  {% if project.data.locations %}

                    {% for location in project.data.locations %}

                      {% if location.map_url %}

                        <a
                          href="{{ location.map_url }}"
                          class="button button-outline"
                          target="_blank"
                          rel="noopener"
                        >
                          Location
                        </a>

                      {% endif %}

                    {% endfor %}

                  {% endif %}


                  <a
                    href="#contact"
                    class="button button-outline"
                  >
                    Details
                  </a>


                </div>


              </div>

            </article>


          {% else %}


            <div>

              <p class="section-text">
                Projects will appear here when they are
                published through the CMS.
              </p>

            </div>


          {% endfor %}


        </div>

      </div>

    </section>



    <!-- =====================================
         CONTACT
    ====================================== -->

    <section
      class="section contact"
      id="contact"
    >

      <div class="container contact-grid">


        <div>

          <div class="eyebrow">
            Get In Touch
          </div>


          <h2 class="section-title">
            Let's Find Your Next Address.
          </h2>


          <p class="section-text">

            Speak with our team about available properties,
            investment opportunities or project information.

          </p>


          <ul class="contact-list">


            <li>

              <strong>
                Office
              </strong>

              {{ contact.address or
              "Bay Square, Business Bay, Dubai, UAE"
              }}

            </li>


            <li>

              <strong>
                Email
              </strong>

              {{ contact.email or
              "info@dubailinkrealty.com"
              }}

            </li>


            <li>

              <strong>
                Phone
              </strong>

              {{ contact.phone or
              "+971 XX XXX XXXX"
              }}

            </li>


            {% if contact.whatsapp %}

              <li>

                <strong>
                  WhatsApp
                </strong>

                {{ contact.whatsapp }}

              </li>

            {% endif %}


          </ul>

        </div>



        <form
          class="contact-form"
          name="property-enquiry"
          method="POST"
          data-netlify="true"
        >

          <input
            type="hidden"
            name="form-name"
            value="property-enquiry"
          >


          <input
            type="text"
            name="name"
            placeholder="Your Name"
          >


          <input
            type="email"
            name="email"
            placeholder="Email Address"
          >


          <input
            type="tel"
            name="phone"
            placeholder="Phone Number"
          >


          <textarea
            name="message"
            placeholder="How can we help?"
          ></textarea>


          <button
            type="submit"
            class="button"
          >
            Send Enquiry
          </button>

        </form>


      </div>

    </section>


  </main>



  <!-- =====================================
       FOOTER
  ====================================== -->

  <footer>

    <div class="container footer-grid">


      <div>

        <h3>
          {{ site.brand_name or "DubaiLink Realty" }}
        </h3>


        <p>

          {{ site.footer_description or
          "Luxury real estate opportunities in Dubai, presented with professionalism and care."
          }}

        </p>

      </div>



      <div>

        <h3>
          Quick Links
        </h3>


        <ul class="footer-links">

          <li>
            <a href="#home">
              Home
            </a>
          </li>

          <li>
            <a href="#about">
              About Us
            </a>
          </li>

          <li>
            <a href="#approach">
              Our Approach
            </a>
          </li>

          <li>
            <a href="#projects">
              Projects
            </a>
          </li>

          <li>
            <a href="#contact">
              Contact
            </a>
          </li>

        </ul>

      </div>



      <div>

        <h3>
          Newsletter
        </h3>


        <p>
          Receive selected property updates and news.
        </p>


        <form
          class="newsletter"
          name="newsletter"
          method="POST"
          data-netlify="true"
        >

          <input
            type="hidden"
            name="form-name"
            value="newsletter"
          >


          <input
            type="email"
            name="email"
            placeholder="Your email"
          >


          <button type="submit">
            →
          </button>

        </form>

      </div>


    </div>



    <div class="container footer-bottom">


      <span>

        © {{ currentYear or "2026" }}

        {{ site.brand_name or "DubaiLink Realty" }}.

        All rights reserved.

      </span>


      <span>

        {{ site.partner_name or "Zoya Developments" }}

        ·

        {{ site.partner_status or "Authorized Partner" }}

      </span>


    </div>

  </footer>



  <!-- =====================================
       MOBILE MENU
  ====================================== -->

  <script>

    const menuToggle =
      document.getElementById("menuToggle");

    const navLinks =
      document.getElementById("navLinks");


    if (menuToggle && navLinks) {

      menuToggle.addEventListener(
        "click",
        function () {

          navLinks.classList.toggle("active");

        }
      );


      document
        .querySelectorAll("#navLinks a")
        .forEach(function (link) {

          link.addEventListener(
            "click",
            function () {

              navLinks.classList.remove("active");

            }
          );

        });

    }

  </script>


</body>

</html>
